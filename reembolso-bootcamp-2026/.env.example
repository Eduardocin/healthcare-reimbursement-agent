# ---------------------------------------------------------- modelo e gateway
# Copie este arquivo para .env e preencha as credenciais recebidas do provedor.
# Nunca adicione o .env ou uma chave real ao Git.
BOOTCAMP_LLM_ENDPOINT=
BOOTCAMP_API_KEY=

# --------------------------------------------------------------------- MCP
# O servidor MCP de desenvolvimento roda localmente. Suba com:
#   docker compose up mcp
# ou execute o servidor incluído em mcp/:
#   MCP_OPERADORA_DADOS=./casos_treino MCP_OPERADORA_TOKEN=treino \
#       python -m mcp_operadora.server
MCP_OPERADORA_URL=http://localhost:9000/mcp
MCP_OPERADORA_TOKEN=treino
